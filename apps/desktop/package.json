{
  "name": "@succulent/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "soak": "node scripts/soak.mjs",
    "build": "vite build && node scripts/build-main.mjs",
    "dist": "pnpm build && node scripts/dist-dir.mjs",
    "dist:dir": "pnpm build && node scripts/dist-dir.mjs --dir"
  },
  "dependencies": {
    "@succulent/render": "workspace:*",
    "@succulent/sim": "workspace:*",
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/three": "^0.170.0",
    "electron": "^36.0.0",
    "esbuild": "^0.25.5",
    "three": "^0.170.0",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.taozhihaoo.a-little-succulent",
    "productName": "a-little-succulent",
    "directories": {
      "output": "dist-pkg",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**",
      "**/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "taozhihaoo",
      "repo": "a-little-succulent"
    }
  },
  "productName": "a-little-succulent"
}
